---
import { getCollection } from "astro:content";
import CtaButton from "../ui/CtaButton.astro";

const steps = (await getCollection("processSteps")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  class="reveal process-reveal from-tertiary/10 via-background bg-radial-[at_25%_50%] py-16"
>
  <div class="space-y-2 text-center">
    <h3 class="reveal-item reveal-fade text-style-small text-style-eyebrow">
      Como funciona
    </h3>

    <p class="reveal-item reveal-fade text-style-lead text-style-accent">
      Sem mistério: um processo simples e transparente, do primeiro papo às
      revisões contínuas.
    </p>
  </div>

  <ol class="relative mt-16 space-y-14 md:space-y-20">
    <svg
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
      class="process-line stroke-tertiary pointer-events-none absolute w-12 fill-none stroke-[1.5] md:w-24"
      style="top: 0; height: 0"
    >
      <path d="M50 0 C 10 30, 90 70, 50 100"></path>
    </svg>

    {
      steps.map(({ data: { title }, body }, index) => (
        <li class="reveal-item relative flex gap-6 md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-12">
          <span
            class="step-marker bg-tertiary text-background text-style-stat relative z-10 flex size-12 shrink-0 items-center justify-center rounded-full md:col-start-2 md:row-start-1 md:size-16 md:justify-self-center"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, "0")}
          </span>

          <div
            class:list={[
              "max-w-lg space-y-2 pt-2",
              index % 2 === 0
                ? "md:col-start-1 md:row-start-1 md:justify-self-end md:pt-0 md:text-right"
                : "md:col-start-3 md:row-start-1 md:justify-self-start md:pt-0",
            ]}
          >
            <h4 class="text-foreground text-style-h2">{title}</h4>
            <p class="text-foreground/70 text-style-body">{body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="reveal-item mt-16 text-center">
    <CtaButton />
  </div>
</section>

<style>
  .reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .process-line {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .process-line {
      clip-path: none;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".process-reveal");
  if (section) {
    const ol = section.querySelector<HTMLElement>("ol");
    const line = section.querySelector<SVGElement>(".process-line");
    const markers = ol
      ? [...ol.querySelectorAll<HTMLElement>(".step-marker")]
      : [];
    const fractionByLi = new Map<HTMLElement, number>();

    const fitLine = () => {
      if (!ol || !line || markers.length < 2) return;

      const first = markers[0];
      const last = markers[markers.length - 1];
      const firstLi = first.closest<HTMLElement>("li");
      const lastLi = last.closest<HTMLElement>("li");
      if (!firstLi || !lastLi) return;

      const firstCenterY =
        firstLi.offsetTop + first.offsetTop + first.offsetHeight / 2;
      const lastCenterY =
        lastLi.offsetTop + last.offsetTop + last.offsetHeight / 2;
      const lineHeight = lastCenterY - firstCenterY;
      const lineWidth = line.getBoundingClientRect().width;
      const firstCenterX =
        firstLi.offsetLeft + first.offsetLeft + first.offsetWidth / 2;

      line.style.top = `${firstCenterY}px`;
      line.style.left = `${firstCenterX - lineWidth / 2}px`;
      line.style.height = `${lineHeight}px`;

      const solveT = (y: number) => {
        let t = y / 100;
        for (let i = 0; i < 8; i++) {
          const value = 90 * t + 30 * t * t - 20 * t * t * t - y;
          const derivative = 90 + 60 * t - 60 * t * t;
          if (derivative === 0) break;
          t -= value / derivative;
          t = Math.min(1, Math.max(0, t));
        }
        return t;
      };

      markers.forEach((marker) => {
        const li = marker.closest<HTMLElement>("li");
        if (!li || lineHeight <= 0) return;

        const centerY =
          li.offsetTop + marker.offsetTop + marker.offsetHeight / 2;
        const f = Math.min(
          1,
          Math.max(0, (centerY - firstCenterY) / lineHeight),
        );
        const t = solveT(f * 100);
        const x = 50 - 120 * t + 360 * t * t - 240 * t * t * t;

        marker.style.transform = `translateX(${((x - 50) / 100) * lineWidth}px)`;
        fractionByLi.set(li, f);
      });
    };

    fitLine();
    window.addEventListener("resize", fitLine);
    document.fonts?.ready.then(fitLine);

    const items = [...section.querySelectorAll<HTMLElement>(".reveal-item")];
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let revealedFraction = 0;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);

          const fraction = fractionByLi.get(entry.target as HTMLElement);
          if (fraction !== undefined && line && !reduceMotion) {
            revealedFraction = Math.max(revealedFraction, fraction);
            line.style.clipPath = `inset(0 0 ${(1 - revealedFraction) * 100}% 0)`;
          }
        }
      },
      { threshold: 1 },
    );

    items.forEach((item) => observer.observe(item));
  }
</script>
