---
import { getCollection } from "astro:content";

const faqs = (await getCollection("faqs")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  class="reveal faqwave-reveal from-tertiary/10 via-background flex flex-col items-center bg-radial-[at_75%_50%]"
>
  <svg
    class="reveal-item w-1/2 max-w-sm"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,50 C240,15 480,85 720,50 C960,15 1200,85 1440,50"
      class="stroke-tertiary fill-none stroke-1"></path>
  </svg>

  <div class="py-16">
    <div class="space-y-2 text-center">
      <h2 class="reveal-item reveal-fade text-style-small text-style-eyebrow">
        Perguntas Frequentes
      </h2>

      <p class="reveal-item reveal-fade text-style-lead text-style-accent">
        Respostas rápidas para as dúvidas mais comuns
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl">
      {
        faqs.map(({ data: { question }, body }, index) => (
          <div class="reveal-item faq-item">
            <button
              type="button"
              class="faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 px-6 py-4 text-left"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
            >
              <span class="text-foreground text-style-h3">{question}</span>

              <span
                class="marker text-secondary relative shrink-0 text-2xl leading-none"
                aria-hidden="true"
              >
                +
              </span>
            </button>

            <div class="faq-body" id={`faq-answer-${index}`}>
              <div class="faq-body-inner">
                <p class="text-foreground/70 text-style-body px-6 pb-6">
                  {body}
                </p>
              </div>
            </div>

            {index !== faqs.length - 1 && <hr class="border-tertiary/10" />}
          </div>
        ))
      }
    </div>

    <div class="reveal-item mt-12 text-center">
      <a
        href="/faq"
        class="hover:text-accent text-foreground/80 text-style-body text-style-accent inline-block"
      >
        Ver todas as perguntas »
      </a>
    </div>
  </div>

  <svg
    class="reveal-item w-1/2 max-w-sm"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,50 C240,85 480,15 720,50 C960,85 1200,15 1440,50"
      class="stroke-tertiary fill-none stroke-1"></path>
  </svg>
</section>

<style>
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .faq-body-inner {
    overflow: hidden;
    min-height: 0;
  }

  .marker {
    transition: transform 0.3s ease;
  }

  .faq-item[data-open] .faq-body {
    grid-template-rows: 1fr;
  }

  .faq-item[data-open] .marker {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-body,
    .marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".faqwave-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 150}ms`);
    });

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { rootMargin: isMobile ? "0px 0px -250px 0px" : "0px 0px -350px 0px" },
    );

    observer.observe(section);
  }

  section?.querySelectorAll(".faq-item").forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger");
    trigger?.addEventListener("click", () => {
      const isOpen = item.toggleAttribute("data-open");
      trigger.setAttribute("aria-expanded", String(isOpen));
    });
  });
</script>
