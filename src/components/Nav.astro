---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "Sobre mim" },
  { href: "/services", label: "Serviços" },
  { href: "/contact", label: "Contato" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  class="relative flex h-[10vh] items-center justify-end px-6 md:justify-center md:px-0"
>
  <nav class="group">
    <button
      type="button"
      class="flex cursor-pointer flex-col gap-1.25 p-2 md:hidden"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Abrir menu"
    >
      <span
        class="bg-foreground h-0.5 w-6 transition-all duration-200 group-data-open:translate-y-1.75 group-data-open:rotate-45"
      ></span>
      <span
        class="bg-foreground h-0.5 w-6 transition-all duration-200 group-data-open:opacity-0"
      ></span>
      <span
        class="bg-foreground h-0.5 w-6 transition-all duration-200 group-data-open:-translate-y-1.75 group-data-open:-rotate-45"
      ></span>
    </button>

    <div
      id="nav-links"
      class="border-foreground/10 bg-background pointer-events-none invisible absolute inset-x-0 top-full z-20 flex -translate-y-2 flex-col gap-4 border-b px-6 py-4 opacity-0 shadow-lg transition-all duration-200 ease-out group-data-open:pointer-events-auto group-data-open:visible group-data-open:translate-y-0 group-data-open:opacity-100 md:pointer-events-auto md:visible md:static md:flex md:translate-y-0 md:flex-row md:items-center md:gap-16 md:border-0 md:bg-transparent md:px-0 md:py-0 md:opacity-100 md:shadow-none"
    >
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="hover:text-accent aria-[current=page]:text-quaternary font-serif font-extralight transition-colors"
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    '[aria-controls="nav-links"]',
  );
  const menu = document.getElementById("nav-links");
  const nav = button?.closest("nav");

  const setState = (open: boolean) => {
    nav?.toggleAttribute("data-open", open);
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
  };

  button?.addEventListener("click", () => {
    setState(!nav?.hasAttribute("data-open"));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setState(false));
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setState(false);
  });
</script>
