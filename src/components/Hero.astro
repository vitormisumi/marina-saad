---
import { Image } from "astro:assets";
import myImage from "../assets/marina.jpg";

const primary = "#000";
const secondary = "#000";
const accent = "#000";
---

<main>
  <section class="hero relative h-[80vh]">
    <div class="flex h-full flex-col justify-center gap-8">
      <h1 class="text-5xl leading-12 font-bold tracking-tight">
        Marina Saad<br />
        <span class="font-serif font-medium text-gray-700 italic">
          Planejadora Financeira
        </span>
      </h1>

      <p class="description leading-5 text-gray-700">
        Transforme sua relação com o dinheiro e construa o futuro que você
        merece.
      </p>

      <button
        class="cta w-min cursor-pointer rounded-lg bg-black px-4 py-2 font-bold whitespace-nowrap text-white drop-shadow-md transition-colors hover:bg-black/90"
      >
        Agende seu Papo Inicial
      </button>
    </div>

    <Image
      src={myImage}
      alt="Marina Saad."
      class="hero-img absolute top-0 right-0 h-full max-h-[70vh] w-auto max-w-4/5 mask-[url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%202000%202000%22%3E%3Cpath%20d=%22M1912%201209c27-319-72-699-318-882-187-139-462-224-785-204S85%20468%2084%20880c0%20455%20481%20345%20636%20484s139%20514%20477%20516c386%203%20693-420%20715-671Z%22%20fill=%22%23808%22%3E%3C/path%3E%3C/svg%3E')] mask-contain mask-clip-border mask-center mask-no-repeat object-cover mix-blend-multiply grayscale"
    />
  </section>
</main>

<style define:vars={{ primary, secondary, accent }}>
  .hero {
    padding: clamp(2rem, 10vw, 16rem);
  }

  .description {
    font-size: clamp(0.8rem, 2vw, 1.2rem);
  }

  .cta {
    font-size: clamp(0.8rem, 2vw, 1rem);
  }
</style>
