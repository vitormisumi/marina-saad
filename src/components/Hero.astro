---
import { Image } from "astro:assets";
import myImage from "../assets/marina.jpg";
---

<main>
  <section class="h-[85vh]">
    <div
      class="relative flex h-full flex-col justify-between gap-8 md:justify-around"
    >
      <h1
        class="leading-10 font-bold tracking-tight md:leading-12 lg:leading-14 xl:leading-16 2xl:leading-18"
      >
        Marina Saad<br />
        <span class="font-serif font-medium text-gray-700 italic">
          Planejadora <br />Financeira
        </span>
      </h1>

      <div class="space-y-4">
        <p class="description leading-5 text-gray-700">
          Transforme sua relação com o dinheiro <br />
          e construa o futuro que você merece.
        </p>

        <button
          class="cta w-min cursor-pointer rounded-lg bg-black px-4 py-2 font-bold whitespace-nowrap text-white drop-shadow-md transition-colors hover:bg-black/90"
        >
          Agende seu Papo Inicial
        </button>
      </div>

      <Image
        src={myImage}
        alt="Marina Saad."
        class="hero-img absolute top-0 right-0 h-full object-cover mix-blend-multiply grayscale"
      />
    </div>
  </section>

  <style>
    main {
      padding: 2rem clamp(2rem, 10vw, 16rem);
    }

    h1 {
      font-size: clamp(2.5rem, 5vw, 5rem);
    }

    .description {
      font-size: clamp(0.8rem, 2vw, 1.2rem);
    }

    .cta {
      font-size: clamp(0.8rem, 2vw, 1rem);
    }

    .hero-img {
      width: max(450px, 50%);
      mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2000 2000"><path d="M1912 1209c27-319-72-699-318-882-187-139-462-224-785-204S85 468 84 880c0 455 481 345 636 484s139 514 477 516c386 3 693-420 715-671Z" fill="%23808"></path></svg>');
      mask-position: center;
      mask-repeat: no-repeat;
    }
  </style>
</main>
