---
import { getCollection } from "astro:content";

const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => a.data.order - b.data.order,
);

const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .slice(0, 2)
    .join("");

const blobPaths = [
  "M395 112C815 94 1265 146 1630 126C1848 114 1942 255 1942 505C1942 825 1928 1190 1920 1500C1912 1780 1755 1918 1515 1926C1115 1938 805 1928 415 1942C215 1950 74 1778 68 1460C64 1120 100 782 84 462C70 222 195 130 395 112Z",
  "M370 116C760 122 1250 84 1655 110C1866 96 1948 300 1936 520C1928 830 1936 1180 1930 1490C1924 1768 1798 1932 1560 1940C1150 1920 795 1944 395 1940C188 1950 84 1792 74 1470C68 1120 90 762 74 442C60 192 168 130 370 116Z",
  "M380 110C800 86 1250 154 1640 122C1852 102 1944 240 1940 470C1936 800 1940 1200 1928 1510C1916 1778 1762 1922 1540 1930C1130 1942 815 1912 405 1944C200 1962 76 1806 70 1495C66 1150 94 790 78 455C66 215 180 126 380 110Z",
];
---

<section class="reveal testimonials-reveal">
  <div class="space-y-2 text-center md:text-left">
    <h3 class="reveal-item reveal-fade font-sans text-4xl font-bold">
      O que dizem meus clientes
    </h3>

    <p class="reveal-item reveal-fade tracking-tight italic">
      Histórias de quem transformou sua relação com o dinheiro
    </p>
  </div>

  <div class="mt-12 grid gap-4 md:grid-cols-3">
    {
      testimonials.map(({ data: { name, role }, body }, index) => (
        <figure class="reveal-item transition-scale relative flex flex-col justify-between gap-8 p-10 hover:scale-105 md:p-8 lg:p-12">
          <svg
            class="absolute inset-0 -z-10 h-full w-full"
            viewBox="0 0 2000 2000"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d={blobPaths[index]} class="fill-background" />
            <path
              d={blobPaths[index]}
              vector-effect="non-scaling-stroke"
              class="fill-tertiary/10"
            />
          </svg>

          <blockquote class="before:text-foreground/30 relative pt-8 before:absolute before:top-4 before:-left-2 before:font-serif before:text-5xl before:leading-8 before:italic before:content-['“']">
            <p class="text-foreground/80 leading-6 md:leading-7">{body}</p>
          </blockquote>

          <figcaption class="relative flex items-center gap-4 md:flex-col md:text-center lg:flex-row lg:text-left">
            <span
              class="bg-tertiary flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-sans text-sm font-semibold text-white"
              aria-hidden="true"
            >
              {initials(name)}
            </span>

            <span class="space-y-0.5">
              <span class="block font-sans text-sm font-semibold">{name}</span>
              <span class="text-foreground/70 block font-serif text-sm font-light">
                {role}
              </span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  h2 {
    font-size: clamp(2rem, 3.5vw, 3rem);
  }

  section > div:first-child p {
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  blockquote p {
    font-size: clamp(0.875rem, 1.5vw, 1.125rem);
  }

  .reveal-item {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 0.7s ease var(--reveal-delay, 0ms),
      transform 0.7s ease var(--reveal-delay, 0ms),
      scale 0.3s ease;
  }

  .reveal-item.reveal-fade {
    transform: none;
  }

  .reveal.is-visible .reveal-item {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".testimonials-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 250}ms`);
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { threshold: 0.4 },
    );

    observer.observe(section);
  }
</script>
