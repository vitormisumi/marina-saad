---
const stats = [
  {
    value: `${new Date().getFullYear() - 2014}+`,
    label: "anos de experiência",
  },
  { value: "60+", label: "clientes atendidos" },
  { value: "R$ 10M+", label: "em patrimônio assessorado" },
];

const credentials = ["CFP®", "CVM", "ANBIMA"];
---

<section
  aria-label="Credenciais e resultados"
  class="reveal trustbar-reveal painpoint-organic bg-tertiary/10 py-16"
>
  <div>
    <dl class="flex flex-col justify-around gap-12 py-8 md:flex-row md:gap-6">
      {
        stats.map(({ value, label }) => (
          <div class="reveal-item space-y-1 text-center">
            <dd class="stat text-foreground text-3xl md:text-4xl">{value}</dd>
            <dt class="text-foreground/70 accent text-sm">{label}</dt>
          </div>
        ))
      }
    </dl>

    <hr class="border-tertiary/10" />

    <ul class="flex items-center justify-center gap-6 py-8 md:gap-8">
      {
        credentials.map((credential) => (
          <li class="border-foreground/20 eyebrow reveal-item rounded-lg border px-4 py-2 text-sm">
            {credential}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .painpoint-organic {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 7C18 2 31 11 48 7C66 3 81 12 100 5V94C82 98 67 89 50 94C31 99 17 89 0 95Z" fill="white"/></svg>');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>(".trustbar-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    items.forEach((item, index) => {
      (item as HTMLElement).style.setProperty(
        "--reveal-delay",
        `${index * 150}ms`,
      );
    });

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { rootMargin: isMobile ? "0px 0px -300px 0px" : "0px 0px -200px 0px" },
    );

    observer.observe(section);
  }
</script>
