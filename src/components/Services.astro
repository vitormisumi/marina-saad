---

<section class="reveal services-blob-reveal relative min-h-[50vh] py-16">
  <div class="space-y-2 py-8 text-center md:text-left">
    <h3 class="reveal-item reveal-fade heading">Como posso te ajudar</h3>

    <p class="reveal-item reveal-fade accent">
      Cada planejamento é único, customizado para as suas necessidades e
      objetivos. Descubra abaixo alguns dos serviços que ofereço:
    </p>
  </div>

  <div
    class="mt-8 grid grid-cols-2 place-content-center place-items-center gap-6 pb-4 xl:grid-cols-4"
  >
    {
      services.map(({ title, tagline, img }, index) => {
        return (
          <a
            href="/services"
            data-parallax={index % 2 === 0 ? "slow" : "fast"}
            class="reveal-item group border-tertiary/20 bg-background hover:border-tertiary after:text-secondary hover:after:text-tertiary/10 services-card relative flex aspect-square w-full max-w-xs items-center justify-center gap-4 overflow-hidden rounded-2xl border p-2 text-center after:absolute after:right-2 after:bottom-2 after:text-5xl after:opacity-100 after:transition-opacity after:delay-1000 after:duration-300 after:content-['...'] hover:after:opacity-0 hover:after:delay-0 hover:after:duration-0 xl:p-8 xl:after:right-6 xl:after:bottom-6"
          >
            <span class="text-foreground text-lg font-semibold xl:text-2xl">
              {title}
            </span>

            <span
              class="blob-reveal text-foreground accent bg-background absolute inset-0 flex items-center justify-center px-6 text-base xl:text-lg"
              style={`--blob-mask: ${blobMaskUrl(blobPaths[index], { transform: "translate(100 100)" })};`}
            >
              <Image
                src={img}
                alt={title}
                priority={false}
                quality="low"
                layout="constrained"
                class="absolute inset-0 h-full object-cover opacity-10"
              />

              <span class="bg-tertiary/5 absolute inset-0" />

              <span class="relative">{tagline}</span>

              <span class="text-foreground absolute right-2 bottom-2 font-serif text-sm group-hover:underline xl:right-6 xl:bottom-6">
                Saiba mais »
              </span>
            </span>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .services-card {
    translate: 0 var(--parallax-y, 0px);
    will-change: transform, translate;
    transition:
      opacity 0.7s ease var(--reveal-delay, 0ms),
      transform 0.7s ease var(--reveal-delay, 0ms),
      border-color 1s ease,
      background-color 1s ease;
  }

  .blob-reveal {
    mask-image: var(--blob-mask);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: 0% 0%;
    transition: mask-size 1s ease-in-out;
  }

  .card-bg {
    background-image: var(--card-bg);
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 0.5s ease,
      transform 1s ease;
  }

  @media (hover: hover) {
    .group:hover .blob-reveal {
      mask-size: 500% 500%;
    }

    .group:hover .card-bg {
      opacity: 1;
      transform: scale(1);
    }
  }

  .group:focus-visible .blob-reveal,
  .group.is-open .blob-reveal {
    mask-size: 500% 500%;
  }

  .group:focus-visible .card-bg,
  .group.is-open .card-bg {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .services-card {
      translate: none;
      will-change: auto;
      transition: none;
    }

    .reveal-item .blob-reveal {
      transition: none;
    }

    .card-bg {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".services-blob-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 150}ms`);
    });

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { rootMargin: isMobile ? "0px 0px -250px 0px" : "0px 0px -350px 0px" },
    );

    observer.observe(section);

    if (window.matchMedia("(hover: none)").matches) {
      const cards = [
        ...section.querySelectorAll("a[href='/services']"),
      ] as HTMLElement[];

      cards.forEach((card) => {
        card.addEventListener("click", (event) => {
          if (!card.classList.contains("is-open")) {
            event.preventDefault();
            cards.forEach(
              (other) => other !== card && other.classList.remove("is-open"),
            );
            card.classList.add("is-open");
          }
        });
      });

      document.addEventListener("click", (event) => {
        cards.forEach((card) => {
          if (
            card.classList.contains("is-open") &&
            !card.contains(event.target as Node)
          ) {
            card.classList.remove("is-open");
          }
        });
      });
    }

    // Parallax: colunas pares (lenta) e ímpares (rápida) sobem em ritmos diferentes.
    // Usa `data-parallax="slow" | "fast"` (= colunas 1 e 3 vs 2 e 4 no desktop,
    // 1 vs 2 no mobile) e a propriedade CSS independente `translate`,
    // então não conflita com o `transform` do reveal.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduceMotion) {
      const parallaxCards = [
        ...section.querySelectorAll<HTMLElement>("[data-parallax]"),
      ];
      const SLOW_FACTOR = 0.05;
      const FAST_FACTOR = 0.15;
      let ticking = false;

      const updateParallax = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const viewportH = window.innerHeight;

        if (rect.bottom < 0 || rect.top > viewportH) return;

        const distance = rect.top + rect.height / 2 - viewportH / 2;
        const slowY = distance * SLOW_FACTOR;
        const fastY = distance * FAST_FACTOR;

        for (const card of parallaxCards) {
          card.style.setProperty(
            "--parallax-y",
            `${card.dataset.parallax === "fast" ? fastY : slowY}px`,
          );
        }
      };

      const requestParallax = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateParallax);
        }
      };

      window.addEventListener("scroll", requestParallax, { passive: true });
      window.addEventListener("resize", requestParallax);
      requestParallax();
    }
  }
</script>
