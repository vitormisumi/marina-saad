---
import { blobMaskUrl } from "../lib/blobMask";

const services = [
  {
    title: "Gestão de Dívidas",
    tagline: "Um plano para sair do vermelho",
  },
  {
    title: "Finanças para Autônomos",
    tagline: "Seu negócio no azul",
  },
  {
    title: "Análise de Investimentos",
    tagline: "Investir com segurança",
  },
  {
    title: "Planejamento de Sonhos",
    tagline: "Realize o que importa",
  },
];

const blobPaths = [
  "M25.6,-32C37.8,-26.4,55.4,-25.1,64.4,-16.4C73.4,-7.8,73.8,8.1,67.1,19.8C60.5,31.4,47,38.7,34.6,50.3C22.3,62,11.1,78,-4.1,83.6C-19.3,89.3,-38.6,84.5,-44.7,70.8C-50.8,57.1,-43.7,34.5,-43.8,18C-43.8,1.6,-51.1,-8.7,-50.8,-18.7C-50.5,-28.6,-42.7,-38.3,-33,-44.7C-23.2,-51.1,-11.6,-54.2,-2.5,-50.8C6.7,-47.4,13.4,-37.6,25.6,-32Z",
  "M19.8,-25.7C29,-20.6,42.1,-19.3,45.6,-13.6C49,-8,43,2,41.2,15.2C39.4,28.4,42,44.9,35.9,56.1C29.7,67.3,14.9,73.3,2,70.6C-11,67.9,-21.9,56.6,-35.3,47.7C-48.7,38.9,-64.5,32.5,-73.7,20.2C-82.9,7.9,-85.5,-10.4,-75,-18.7C-64.5,-27,-40.9,-25.5,-26.3,-28.8C-11.6,-32.2,-5.8,-40.4,-0.2,-40.1C5.3,-39.8,10.6,-30.8,19.8,-25.7Z",
  "M29,-41.8C40.3,-31.7,54.1,-26.9,56.7,-18.5C59.3,-10.1,50.8,1.8,44.9,13C39.1,24.2,35.9,34.6,28.9,38.3C21.8,42,10.9,38.9,-2.8,42.8C-16.5,46.6,-33.1,57.4,-48.7,56.6C-64.4,55.7,-79.2,43.1,-82.2,28.1C-85.2,13,-76.4,-4.5,-63.7,-13.6C-50.9,-22.6,-34.1,-23.2,-22.8,-33.3C-11.6,-43.4,-5.8,-62.9,1.5,-65C8.8,-67.1,17.7,-51.8,29,-41.8Z",
  "M33.4,-39.1C46.4,-36.6,62.2,-31,72.4,-18.9C82.7,-6.9,87.5,11.6,80.3,23.7C73.1,35.9,53.9,41.8,38.5,51.4C23.1,60.9,11.6,74,3.1,69.7C-5.3,65.4,-10.7,43.7,-21.2,32.6C-31.7,21.5,-47.4,21,-53.3,14.6C-59.1,8.2,-55.1,-4.2,-54.1,-20.7C-53,-37.2,-55.1,-57.9,-46.6,-61.9C-38.1,-65.8,-19,-53,-4.4,-46.9C10.2,-40.9,20.5,-41.5,33.4,-39.1Z",
];
---

<section class="reveal services-blob-reveal relative min-h-[50vh] py-16">
  <div class="space-y-2 py-8 text-center md:text-left">
    <h3 class="reveal-item reveal-fade heading">Como posso te ajudar</h3>

    <p class="reveal-item reveal-fade accent">
      Cada planejamento é único, customizado para as suas necessidades e
      objetivos. Aqui estão alguns exemplos de serviços que ofereço:
    </p>
  </div>

  <div
    class="mt-8 grid place-content-center gap-6 pb-4 md:grid-cols-2 xl:grid-cols-4"
  >
    {
      services.map(({ title, tagline }, index) => (
        <a
          href="/services"
          class="reveal-item group border-tertiary/50 bg-background relative flex aspect-square max-w-xs flex-col gap-4 overflow-hidden rounded-3xl border p-6"
        >
          <span class="text-foreground text-xl font-semibold lg:text-lg">
            {title}
          </span>

          <span
            class="blob-reveal text-foreground accent bg-tertiary/10 absolute inset-0 flex items-center justify-center px-6 text-lg"
            style={`--blob-mask: ${blobMaskUrl(blobPaths[index], { transform: "translate(100 100)" })}`}
          >
            {tagline}

            <span class="text-accent absolute right-6 bottom-6 font-serif text-sm group-hover:underline">
              Saiba mais »
            </span>
          </span>
        </a>
      ))
    }
  </div>

  <svg
    class="reveal-item absolute top-1/2 right-1/2 -z-10 w-6/7 translate-x-1/2"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,50 C240,15 480,85 720,50 C960,15 1200,85 1440,50"
      class="stroke-tertiary/50 fill-none stroke-1"></path>
  </svg>
</section>

<style>
  .blob-reveal {
    mask-image: var(--blob-mask);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: 0% 0%;
    transition: mask-size 1s ease-in-out;
  }

  @media (hover: hover) {
    .group:hover .blob-reveal {
      mask-size: 500% 500%;
    }
  }

  .group:focus-visible .blob-reveal,
  .group.is-open .blob-reveal {
    mask-size: 500% 500%;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-item .blob-reveal {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".services-blob-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 150}ms`);
    });

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { rootMargin: isMobile ? "0px 0px -250px 0px" : "0px 0px -350px 0px" },
    );

    observer.observe(section);

    if (window.matchMedia("(hover: none)").matches) {
      const cards = [
        ...section.querySelectorAll("a[href='/services']"),
      ] as HTMLElement[];

      cards.forEach((card) => {
        card.addEventListener("click", (event) => {
          if (!card.classList.contains("is-open")) {
            event.preventDefault();
            cards.forEach(
              (other) => other !== card && other.classList.remove("is-open"),
            );
            card.classList.add("is-open");
          }
        });
      });

      document.addEventListener("click", (event) => {
        cards.forEach((card) => {
          if (
            card.classList.contains("is-open") &&
            !card.contains(event.target as Node)
          ) {
            card.classList.remove("is-open");
          }
        });
      });
    }
  }
</script>
