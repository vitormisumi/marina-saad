---
const phrases = [
  "...planejar a aposentadoria?",
  "...quitar as dívidas?",
  "...controlar os gastos?",
  "...investir com segurança?",
  "...organizar seu negócio?",
  "...alcançar seus sonhos?",
];
---

<div class="painpoint-shell relative">
  <svg
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    class="organic-line text-tertiary/70"
    aria-hidden="true"
  >
    <path
      d="M0 6C10 2 18 0 28 5C35 9 41 10 48 6C57 2 64 0 73 6C82 12 91 9 100 4"
      class="stroke-tertiary fill-none stroke-[0.3]"></path>
  </svg>

  <svg
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    class="organic-line text-tertiary/70"
    aria-hidden="true"
  >
    <path
      d="M0 94C10 98 18 100 28 95C35 91 42 90 50 95C58 99 65 100 73 94C82 88 91 91 100 93"
      class="stroke-tertiary fill-none stroke-[0.3]"></path>
  </svg>

  <section
    class="reveal painpoint-reveal painpoint-organic bg-tertiary/10 py-16"
  >
    <div class="relative z-10 space-y-8 text-center md:text-left">
      <p class="reveal-item reveal-fade text-foreground/60 eyebrow">
        Quer ajuda para...
      </p>

      <h3 class="reveal-item reveal-fade accent leading-2">
        <span id="typewriter-text" data-phrases={JSON.stringify(phrases)}
          >{phrases[0]}</span
        ><span
          class="animate-blink bg-accent ml-1 inline-block h-[1em] w-[0.05em] translate-y-0.5 align-baseline"
          aria-hidden="true"></span>
      </h3>

      <p class="reveal-item reveal-fade text-foreground/70">
        Você não precisa de fórmulas prontas — precisa de um plano que caiba na
        sua vida.
      </p>
    </div>
  </section>
</div>

<style>
  .painpoint-organic {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0 7C18 2 31 11 48 7C66 3 81 12 100 5V94C82 98 67 89 50 94C31 99 17 89 0 95Z" fill="white"/></svg>');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }

  h3 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  section > div > p:last-child {
    font-size: clamp(0.875rem, 1.5vw, 1.125rem);
  }

  .reveal-item {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 0.7s ease var(--reveal-delay, 0ms),
      transform 0.7s ease var(--reveal-delay, 0ms);
  }

  .reveal-item.reveal-fade {
    transform: none;
  }

  .reveal.is-visible .reveal-item {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .caret {
      animation: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".painpoint-reveal");
  const typewriter = document.querySelector<HTMLElement>("#typewriter-text");

  const startTypewriter = (el: HTMLElement) => {
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? "[]");
    if (
      !phrases.length ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }

    const typeSpeed = 100;
    const deleteSpeed = 30;
    const holdTime = 2000;

    let phraseIndex = 0;
    let charIndex = phrases[0].length;
    let deleting = true;

    const tick = () => {
      const current = phrases[phraseIndex];

      if (deleting) {
        charIndex--;
        el.textContent = current.slice(0, charIndex);

        if (charIndex === 0) {
          deleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
        }

        setTimeout(tick, deleteSpeed);
      } else {
        charIndex++;
        el.textContent = phrases[phraseIndex].slice(0, charIndex);

        if (charIndex === phrases[phraseIndex].length) {
          deleting = true;
          setTimeout(tick, holdTime);
          return;
        }

        setTimeout(tick, typeSpeed);
      }
    };

    setTimeout(tick, holdTime);
  };

  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 250}ms`);
    });

    let started = false;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();

          if (typewriter && !started) {
            started = true;
            startTypewriter(typewriter);
          }
        }
      },
      { threshold: 0.4 },
    );

    observer.observe(section);
  }
</script>
