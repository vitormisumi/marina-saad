---
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Finanças para Autônomos",
    icon: "circum:wallet",
    tagline: "Seu negócio no azul",
  },
  {
    title: "Planejamento de Sonhos",
    icon: "circum:plane",
    tagline: "Realize o que importa",
  },
  {
    title: "Análise de Investimentos",
    icon: "circum:bank",
    tagline: "Investir com segurança",
  },
  {
    title: "Gestão de Dívidas",
    icon: "circum:credit-card-off",
    tagline: "Um plano para sair do vermelho",
  },
];

const blobPaths = [
  "M25.6,-32C37.8,-26.4,55.4,-25.1,64.4,-16.4C73.4,-7.8,73.8,8.1,67.1,19.8C60.5,31.4,47,38.7,34.6,50.3C22.3,62,11.1,78,-4.1,83.6C-19.3,89.3,-38.6,84.5,-44.7,70.8C-50.8,57.1,-43.7,34.5,-43.8,18C-43.8,1.6,-51.1,-8.7,-50.8,-18.7C-50.5,-28.6,-42.7,-38.3,-33,-44.7C-23.2,-51.1,-11.6,-54.2,-2.5,-50.8C6.7,-47.4,13.4,-37.6,25.6,-32Z",
  "M19.8,-25.7C29,-20.6,42.1,-19.3,45.6,-13.6C49,-8,43,2,41.2,15.2C39.4,28.4,42,44.9,35.9,56.1C29.7,67.3,14.9,73.3,2,70.6C-11,67.9,-21.9,56.6,-35.3,47.7C-48.7,38.9,-64.5,32.5,-73.7,20.2C-82.9,7.9,-85.5,-10.4,-75,-18.7C-64.5,-27,-40.9,-25.5,-26.3,-28.8C-11.6,-32.2,-5.8,-40.4,-0.2,-40.1C5.3,-39.8,10.6,-30.8,19.8,-25.7Z",
  "M29,-41.8C40.3,-31.7,54.1,-26.9,56.7,-18.5C59.3,-10.1,50.8,1.8,44.9,13C39.1,24.2,35.9,34.6,28.9,38.3C21.8,42,10.9,38.9,-2.8,42.8C-16.5,46.6,-33.1,57.4,-48.7,56.6C-64.4,55.7,-79.2,43.1,-82.2,28.1C-85.2,13,-76.4,-4.5,-63.7,-13.6C-50.9,-22.6,-34.1,-23.2,-22.8,-33.3C-11.6,-43.4,-5.8,-62.9,1.5,-65C8.8,-67.1,17.7,-51.8,29,-41.8Z",
  "M30.4,-37.7C40.4,-34.7,50,-27,57.5,-15.8C65.1,-4.7,70.6,10,65.3,19.6C60,29.2,43.9,33.7,31.2,40.7C18.5,47.8,9.2,57.5,-2.1,60.4C-13.4,63.2,-26.8,59.3,-42.6,53.2C-58.5,47.2,-76.7,39,-85.2,24.9C-93.6,10.7,-92.3,-9.4,-83.3,-24C-74.3,-38.6,-57.7,-47.6,-42.6,-48.9C-27.4,-50.3,-13.7,-44,-1.7,-41.6C10.3,-39.3,20.5,-40.8,30.4,-37.7Z",
];

function createBlobMaskUrl(path: string) {
  return `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><path d="${path}" transform="translate(100 100)" fill="black" /></svg>`)}")`;
}
---

<section
  class="reveal services-blob-reveal from-background via-tertiary/10 to-background min-h-[50vh] bg-linear-to-b py-16"
>
  <div class="space-y-2 py-8 text-center md:text-left">
    <h3 class="reveal-item reveal-fade text-foreground/60 eyebrow">
      Como posso te ajudar
    </h3>

    <p class="reveal-item reveal-fade accent">
      Cada planejamento é único, customizado para as suas necessidades e
      objetivos. Aqui estão alguns exemplos de serviços que ofereço:
    </p>
  </div>

  <div class="grid gap-6 pb-4 md:grid-cols-2 lg:grid-cols-4">
    {
      services.map(({ title, icon, tagline }, index) => (
        <a
          href="/services"
          class="reveal-item group bg-background border-secondary relative flex flex-col items-center gap-4 overflow-hidden rounded-lg border p-10 md:p-8"
        >
          <Icon name={icon} class="text-secondary size-8" />

          <span class="text-foreground leading-snug font-semibold">
            {title}
          </span>

          <span
            class="blob-reveal text-foreground accent bg-secondary absolute inset-0 flex items-center justify-center px-6 text-lg"
            style={`--blob-mask: ${createBlobMaskUrl(blobPaths[index])}`}
          >
            {tagline}
            <span class="text-foreground absolute right-2 bottom-2 font-serif text-xs">
              Saiba mais »
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .reveal-item {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 0.7s ease var(--reveal-delay, 0ms),
      transform 0.7s ease var(--reveal-delay, 0ms),
      scale 0.3s ease;
  }

  .reveal-item.reveal-fade {
    transform: none;
  }

  .reveal.is-visible .reveal-item {
    opacity: 1;
    transform: translateY(0);
  }

  .blob-reveal {
    mask-image: var(--blob-mask);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: 0% 0%;
    transition: mask-size 1s ease-in-out;
  }

  .group:hover .blob-reveal {
    mask-size: 700% 700%;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .reveal-item .blob-reveal {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".services-blob-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 150}ms`);
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { threshold: 0.4 },
    );

    observer.observe(section);
  }
</script>
