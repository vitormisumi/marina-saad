---
import { blobMaskUrl } from "../../lib/blobMask";

const values = [
  {
    title: "Clareza",
    body: "Nada de termos complicados. Você entende cada decisão do seu plano e o porquê de cada passo.",
  },
  {
    title: "Proximidade",
    body: "Conversas honestas e sem julgamentos, no seu ritmo, para que você se sinta seguro em cada escolha.",
  },
  {
    title: "Constância",
    body: "Acompanhamento contínuo para que o plano continue fazendo sentido conforme a sua vida muda.",
  },
];

const blobPaths = [
  "M395 112C815 94 1265 146 1630 126C1848 114 1942 255 1942 505C1942 825 1928 1190 1920 1500C1912 1780 1755 1918 1515 1926C1115 1938 805 1928 415 1942C215 1950 74 1778 68 1460C64 1120 100 782 84 462C70 222 195 130 395 112Z",
  "M370 116C760 122 1250 84 1655 110C1866 96 1948 300 1936 520C1928 830 1936 1180 1930 1490C1924 1768 1798 1932 1560 1940C1150 1920 795 1944 395 1940C188 1950 84 1792 74 1470C68 1120 90 762 74 442C60 192 168 130 370 116Z",
  "M380 110C800 86 1250 154 1640 122C1852 102 1944 240 1940 470C1936 800 1940 1200 1928 1510C1916 1778 1762 1922 1540 1930C1130 1942 815 1912 405 1944C200 1962 76 1806 70 1495C66 1150 94 790 78 455C66 215 180 126 380 110Z",
];
---

<section class="reveal about-values-reveal py-16">
  <div class="space-y-2 text-center md:text-left">
    <h3 class="reveal-item reveal-fade text-style-small text-style-eyebrow">
      No que acredito
    </h3>

    <h2 class="reveal-item reveal-fade text-style-h1">
      O que você pode esperar de mim
    </h2>
  </div>

  <div class="mt-12 grid gap-4 lg:grid-cols-3">
    {
      values.map(({ title, body }, index) => (
        <article
          class="blob-mask reveal-item bg-tertiary/10 flex flex-col gap-3 p-10 hover:scale-105 md:p-12"
          style={`--blob-mask: ${blobMaskUrl(blobPaths[index], { viewBox: "0 0 2000 2000", preserveAspectRatio: "none" })}`}
        >
          <h4 class="text-foreground text-style-h2">{title}</h4>
          <p class="text-foreground/70 text-style-body">{body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .blob-mask {
    mask-image: var(--blob-mask);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: 100% 100%;
  }
</style>

<script>
  const section = document.querySelector(".about-values-reveal");
  if (section) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 200}ms`);
    });

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { rootMargin: isMobile ? "0px 0px -200px 0px" : "0px 0px -120px 0px" },
    );

    observer.observe(section);
  }
</script>
