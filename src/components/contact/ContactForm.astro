---
const fieldClass =
  "border-foreground/20 text-foreground placeholder:text-foreground/40 focus:border-accent focus:shadow-[0_1px_0_0_var(--color-accent)] text-style-body w-full border-b bg-transparent px-1 py-3 transition-all outline-none";

const labelClass = "text-style-small text-style-eyebrow";
---

<div class="reveal contact-form-reveal space-y-5">
  <div class="space-y-2">
    <h2 class="text-style-h2">Prefere escrever primeiro?</h2>

    <p class="text-foreground/70 text-style-body">
      Me conte um pouco do que você busca. Respondo em até 1 dia útil.
    </p>
  </div>

  <form
    id="contact-form"
    name="contato"
    method="POST"
    action="/contact"
    data-netlify="true"
    data-netlify-recaptcha="true"
    netlify-honeypot="bot-field"
    class="bg-tertiary/10 flex flex-col gap-6 rounded-2xl p-6 md:p-8"
  >
    <input type="hidden" name="form-name" value="contato" />

    <div class="hidden" aria-hidden="true">
      <label>
        Não preencha este campo se você for humano:
        <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label for="contact-name" class={labelClass}>Nome</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class={fieldClass}
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="contact-email" class={labelClass}>E-mail</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class={fieldClass}
        />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label for="contact-whatsapp" class={labelClass}>
        WhatsApp <span class="text-foreground/50">(opcional)</span>
      </label>
      <input
        id="contact-whatsapp"
        name="whatsapp"
        type="tel"
        autocomplete="tel"
        class={fieldClass}
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="contact-message" class={labelClass}>Mensagem</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        class={`${fieldClass} resize-y`}></textarea>
    </div>

    <label class="text-style-small text-foreground/80 flex items-start gap-3">
      <input
        type="checkbox"
        name="consent"
        required
        class="accent-accent mt-1 size-4 shrink-0"
      />
      <span>
        Concordo em ter meus dados usados apenas para este contato, conforme a
        LGPD.
      </span>
    </label>

    <div data-netlify-recaptcha="true"></div>

    <button
      type="submit"
      class="text-style-body bg-accent hover:bg-accent/90 text-background w-full cursor-pointer rounded-lg px-6 py-1 font-semibold whitespace-nowrap transition-colors disabled:cursor-not-allowed disabled:opacity-60 sm:w-min sm:self-end"
    >
      Enviar mensagem
    </button>

    <p
      id="contact-form-status"
      role="status"
      aria-live="polite"
      class="text-foreground/70 text-style-small empty:hidden"
    >
    </p>
  </form>

  <div
    id="contact-form-success"
    hidden
    class="bg-tertiary/10 space-y-2 rounded-2xl p-8 text-center"
  >
    <h3 class="text-foreground text-style-h2">Mensagem enviada!</h3>
    <p class="text-foreground/70 text-style-body">
      Obrigada por escrever. Respondo em até 1 dia útil no e-mail que você
      informou.
    </p>
  </div>
</div>

<script>
  import { initReveal } from "../../lib/reveal";

  initReveal({ selector: ".contact-form-reveal" });

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-form-status");
  const success = document.querySelector<HTMLElement>("#contact-form-success");

  const setStatus = (message: string, isError = false) => {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle("text-red-600", isError);
  };

  if (form) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const submitButton = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      submitButton?.setAttribute("disabled", "");
      setStatus("Enviando...");

      try {
        const payload = new URLSearchParams();
        new FormData(form).forEach((value, key) => {
          if (typeof value === "string") payload.append(key, value);
        });

        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: payload.toString(),
        });

        if (!response.ok) throw new Error("Request failed");

        form.hidden = true;
        if (success) success.hidden = false;
      } catch {
        setStatus(
          "Não foi possível enviar agora. Tente novamente ou me chame no WhatsApp.",
          true,
        );
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }
</script>
