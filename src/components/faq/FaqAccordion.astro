---
interface FaqEntry {
  question: string;
  text: string;
}

interface Props {
  faqs: FaqEntry[];
  idPrefix: string;
}

const { faqs, idPrefix } = Astro.props;
---

<div class="mx-auto w-full max-w-2xl">
  {
    faqs.map(({ question, text }, index) => {
      const answerId = `${idPrefix}-answer-${index}`;

      return (
        <div class="reveal-item faq-item">
          <button
            type="button"
            class="faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 px-6 py-4 text-left"
            aria-expanded="false"
            aria-controls={answerId}
          >
            <span class="text-foreground text-style-h3">{question}</span>

            <span
              class="marker text-secondary relative shrink-0 text-2xl leading-none"
              aria-hidden="true"
            >
              +
            </span>
          </button>

          <div class="faq-body" id={answerId}>
            <div class="faq-body-inner">
              <p class="text-foreground/70 text-style-body px-6 pb-6">{text}</p>
            </div>
          </div>

          {index !== faqs.length - 1 && <hr class="border-tertiary/10" />}
        </div>
      );
    })
  }
</div>

<style>
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .faq-body-inner {
    overflow: hidden;
    min-height: 0;
  }

  .marker {
    transition: transform 0.3s ease;
  }

  .faq-item[data-open] .faq-body {
    grid-template-rows: 1fr;
  }

  .faq-item[data-open] .marker {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-body,
    .marker {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".faq-item").forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger");

    trigger?.addEventListener("click", () => {
      const isOpen = item.toggleAttribute("data-open");
      trigger.setAttribute("aria-expanded", String(isOpen));
    });
  });
</script>
