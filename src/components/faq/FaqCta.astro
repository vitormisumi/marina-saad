---
import CtaButton from "../ui/CtaButton.astro";
---

<section class="reveal faq-cta-reveal py-16">
  <div class="space-y-6 text-center">
    <h2 class="reveal-item reveal-fade text-style-h1">
      Ainda ficou com alguma dúvida?
    </h2>

    <p
      class="reveal-item reveal-fade text-foreground/70 text-style-lead text-style-accent"
    >
      Me conte o que está na sua cabeça. O Papo Inicial é gratuito e sem
      compromisso.
    </p>

    <div class="reveal-item reveal-fade pt-2">
      <CtaButton />
    </div>
  </div>
</section>

<script>
  import { initReveal } from "../../lib/reveal";

  initReveal({ selector: ".faq-cta-reveal", step: 200 });
</script>
