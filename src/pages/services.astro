---
import { getCollection } from "astro:content";
import ServicesCta from "../components/services/ServicesCta.astro";
import ServicesHero from "../components/services/ServicesHero.astro";
import ServiceSection from "../components/services/ServiceSection.astro";
import Layout from "../layouts/Layout.astro";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  <main class="space-y-24">
    <ServicesHero />

    {
      services.map(({ data }, index) => (
        <ServiceSection
          title={data.title}
          tagline={data.tagline}
          description={data.description}
          img={data.img}
          audience={data.audience}
          includes={data.includes}
          index={index}
        />
      ))
    }

    <ServicesCta />
  </main>
</Layout>
