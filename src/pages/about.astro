---
import AboutHero from "../components/AboutHero.astro";
import AboutValues from "../components/AboutValues.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout>
  <main class="space-y-24">
    <AboutHero />

    <section
      class="reveal about-story-reveal from-tertiary/10 via-background bg-radial-[at_25%_50%] py-16"
    >
      <div class="space-y-2 text-center">
        <h3 class="reveal-item reveal-fade text-style-small text-style-eyebrow">
          Minha história
        </h3>

        <p class="reveal-item reveal-fade text-style-feature text-foreground">
          Dinheiro não é sobre números — é sobre as escolhas que ele torna
          possíveis.
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-3xl space-y-6 text-center">
        <p class="reveal-item reveal-fade text-foreground/70 text-style-body">
          Sou planejadora financeira desde 2014 e, ao longo dessa caminhada, já
          ajudei mais de 60 pessoas e famílias a organizar o orçamento, quitar
          dívidas e realizar sonhos que pareciam distantes.
        </p>

        <p class="reveal-item reveal-fade text-foreground/70 text-style-body">
          Sou certificada CFP® e atuo em conformidade com as normas da CVM e da
          ANBIMA. Mas, mais do que credenciais, o que me move é ver você tomar
          decisões com tranquilidade — sabendo exatamente onde está e para onde
          vai.
        </p>
      </div>
    </section>

    <AboutValues />

    <section class="reveal about-cta-reveal py-16">
      <div class="space-y-6 text-center">
        <h2 class="reveal-item reveal-fade text-style-h1">
          Vamos planejar o seu futuro?
        </h2>

        <p
          class="reveal-item reveal-fade text-foreground/70 text-style-lead text-style-accent"
        >
          Um papo inicial gratuito é o primeiro passo para organizar a sua vida
          financeira.
        </p>

        <div class="reveal-item reveal-fade pt-2">
          <a
            href="/contact"
            class="text-style-cta bg-accent hover:bg-accent/90 text-background inline-block cursor-pointer rounded-lg px-6 py-2 whitespace-nowrap transition-colors"
          >
            Agende seu Papo Inicial
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  for (const section of document.querySelectorAll(
    ".about-story-reveal, .about-cta-reveal",
  )) {
    const items = [...section.querySelectorAll(".reveal-item")];

    (items as HTMLElement[]).forEach((item, index) => {
      item.style.setProperty("--reveal-delay", `${index * 200}ms`);
    });

    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("is-visible");
          observer.disconnect();
        }
      },
      { rootMargin: isMobile ? "0px 0px -250px 0px" : "0px 0px -320px 0px" },
    );

    observer.observe(section);
  }
</script>
